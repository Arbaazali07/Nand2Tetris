CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    DMux(in=load, sel=address[14],
        a=loadRAM, b=loadScreenOrKeyboard);

    DMux(in=loadScreenOrKeyboard, sel=address[13],
        a=loadScreen, b=loadKeyboard);

    RAM16K(in=in, load=loadRAM,
        address=address[0..13], out=ramOut);

    Screen(in=in, load=loadScreen,
        address=address[0..12], out=screenOut);

    Keyboard(out=keyboardOut);

   Mux4Way16(a=ramOut, b=screenOut,
    c=ramOut, d=keyboardOut,
    sel=address[13..14], out=out);
}