CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];

    PARTS:
    Inc16(in=out, out=incOut);

    Mux16(a=out, b=incOut, sel=inc, out=incOrOut);

    Mux16(a=incOrOut, b=in, sel=load, out=loadOrIncOut);

    Mux16(a=loadOrIncOut, b[0..15]=false, sel=reset, out=resetOut);

    Register(in=resetOut, load=true, out=out);
}